[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/overlays/blessings/blessings_overlay.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/themes/gothic_theme.tres" id="2_theme"]

[node name="BlessingsOverlay" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(800, 480)
layout_mode = 2
theme_type_variation = &"PanelIron"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="HBox" type="HBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="RulesVBox" type="VBoxContainer" parent="Panel/Margin/HBox"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="RulesTitle" type="Label" parent="Panel/Margin/HBox/RulesVBox"]
layout_mode = 2
theme_type_variation = &"LabelTitleSmall"
text = "FACTION_RULES"

[node name="Divider" type="HSeparator" parent="Panel/Margin/HBox/RulesVBox"]
layout_mode = 2

[node name="RulesDesc" type="Label" parent="Panel/Margin/HBox/RulesVBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "Mezhebe özel inanç ve savaş esasları burada yer alır."
autowrap_mode = 2

[node name="VSeparator" type="VSeparator" parent="Panel/Margin/HBox"]
layout_mode = 2

[node name="MiraclesVBox" type="VBoxContainer" parent="Panel/Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="MiraclesTitle" type="Label" parent="Panel/Margin/HBox/MiraclesVBox"]
layout_mode = 2
theme_type_variation = &"LabelTitleSmall"
text = "BLESSINGS"

[node name="Divider" type="HSeparator" parent="Panel/Margin/HBox/MiraclesVBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin/HBox/MiraclesVBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="BlessingList" type="VBoxContainer" parent="Panel/Margin/HBox/MiraclesVBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="EmptyLabel" type="Label" parent="Panel/Margin/HBox/MiraclesVBox/Scroll/BlessingList"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"LabelMutedBrown"
text = "NO_FACTION_SELECTED"
theme_override_constants/separation = 8

[node name="CloseBlessingsBtn" type="Button" parent="Panel/Margin/HBox/MiraclesVBox"]
layout_mode = 2
theme_type_variation = &"ButtonGhost"
text = "BACK"
