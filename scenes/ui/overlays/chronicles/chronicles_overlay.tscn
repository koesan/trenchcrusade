[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/overlays/chronicles/chronicles_overlay.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/themes/gothic_theme.tres" id="2_theme"]

[node name="ChroniclesOverlay" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(350, 400)
layout_mode = 2
theme_type_variation = &"PanelIron"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"LabelTitle"
text = "CHRONICLES_TITLE"
horizontal_alignment = 1

[node name="Divider" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="RosterBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonSecondary"
text = "ROSTER"

[node name="ProfileBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonSecondary"
text = "PROFILE"

[node name="BlessingsBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonSecondary"
text = "BLESSINGS"

[node name="LoreBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonSecondary"
text = "LORE_RULES"

[node name="KeywordsBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonSecondary"
text = "KEYWORDS_GLOSSARY"

[node name="Divider2" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="CloseChroniclesBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonGhost"
text = "BACK"
