[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/overlays/roster/roster_overlay.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/themes/gothic_theme.tres" id="2_theme"]

[node name="RosterOverlay" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(650, 480)
layout_mode = 2
theme_type_variation = &"PanelIron"

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HeaderHBox" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Margin/VBox/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LabelTitle"
text = "WARBAND_ROSTER"

[node name="ValueLabel" type="Label" parent="Panel/Margin/VBox/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelGoldAccent"
text = "700 DUKATS"

[node name="Divider" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="FighterList" type="VBoxContainer" parent="Panel/Margin/VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="CloseRosterBtn" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"ButtonGhost"
text = "BACK"
