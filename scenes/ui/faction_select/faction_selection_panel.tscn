[gd_scene load_steps=10 format=3]

[ext_resource type="Theme" path="res://assets/themes/gothic_theme.tres" id="1_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/faction_select/faction_selection.tscn" id="3_faction_card"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/iron_sultanate_logo.webp" id="4_logo_sultanate"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/heretic_legion_logo.webp" id="5_logo_heretic"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/trench_pilgrims_logo.webp" id="6_logo_pilgrims"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/cult_of_the_black_grail_logo.webp" id="7_logo_grail"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/new_antioch_logo.webp" id="8_logo_antioch"]
[ext_resource type="Texture2D" path="res://assets/textures/factions/court_of_seven_headed_serpent_logo.webp" id="9_logo_serpent"]
[ext_resource type="Script" path="res://scenes/ui/faction_select/faction_selection_panel.gd" id="10_script"]

[node name="FactionPanel" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("10_script")


[node name="PanelContainer" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(1130, 260)
layout_mode = 2
theme_type_variation = &"PanelIron"

[node name="MarginContainer" type="MarginContainer" parent="PanelContainer"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBoxContainer" type="VBoxContainer" parent="PanelContainer/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="Label" type="Label" parent="PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"LabelTitleLarge"
text = "FACTION_SELECT_TITLE"
horizontal_alignment = 1

[node name="Description" type="Label" parent="PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"LabelParchmentTan"
text = "FACTION_SELECT_DESC"
horizontal_alignment = 1
autowrap_mode = 2

[node name="HBoxContainer" type="HFlowContainer" parent="PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12
