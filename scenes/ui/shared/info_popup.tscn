[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://assets/themes/gothic_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scenes/ui/shared/info_popup.gd" id="2_script"]

[node name="InfoPopup" type="PanelContainer"]
mouse_filter = 2
theme = ExtResource("1_theme")
theme_type_variation = &"PanelTooltip"
script = ExtResource("2_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelPopupTitle"
autowrap_mode = 3

[node name="SubtitleLabel" type="Label" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelParchmentTan"
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="Divider" type="ColorRect" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.48, 0.35, 0.22, 0.7)

[node name="BodyLabel" type="Label" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="FactsGrid" type="GridContainer" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 4
columns = 2

[node name="Badges" type="HFlowContainer" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4

[node name="Sections" type="VBoxContainer" parent="Margin/Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
