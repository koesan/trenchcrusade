[gd_scene format=3]

[node name="NoticeCard" type="MarginContainer"]
custom_minimum_size = Vector2(460, 0)
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"PanelNotice"

[node name="Row" type="HBoxContainer" parent="Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Stripe" type="ColorRect" parent="Panel/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(3, 0)
layout_mode = 2
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Panel/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Panel/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Title" type="Label" parent="Panel/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"LabelNoticeTitle"

[node name="Body" type="Label" parent="Panel/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"LabelNoticeBody"
autowrap_mode = 3
