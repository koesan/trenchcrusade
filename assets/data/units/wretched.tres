[ext_resource type="Script" path="res://scripts/data/loadout_option.gd" id="5"]
[ext_resource type="Resource" path="res://assets/data/attacks/shotgun.tres" id="6"]

[sub_resource type="Resource" id="LO_STD"]
script = ExtResource("5")
option_name_key = "HL_WRETCHED_LOADOUT_STANDARD"

[sub_resource type="Resource" id="LO_SHOTGUN"]
script = ExtResource("5")
