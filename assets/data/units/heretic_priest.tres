[ext_resource type="Resource" path="res://assets/data/attacks/sacrificial_blade.tres" id="7"]

[sub_resource type="Resource" id="Loadout1"]
script = ExtResource("5")
option_name_key = "HERETIC_PRIEST_LOADOUT_STANDARD"

[sub_resource type="Resource" id="Loadout2"]
script = ExtResource("5")
option_name_key = "HERETIC_PRIEST_LOADOUT_SHOTGUN"
