[gd_resource type="Resource" script_class="UnitData" format=3]

[ext_resource type="Script" path="res://scripts/data/unit_data.gd" id="1"]
[ext_resource type="Resource" path="res://assets/data/attacks/bolt_action_rifle.tres" id="2"]
[ext_resource type="Resource" path="res://assets/data/attacks/trench_knife.tres" id="3_l2gnn"]
