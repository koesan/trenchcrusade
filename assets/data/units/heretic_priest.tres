cost_delta = 23
max_per_warband = 2

[resource]
script = ExtResource("1")
unit_name = "Heretic Priest"
faction_id = &"heretic_legion"
cost = 91
kit_cost = 11
availability_max = 1
melee_dice_modifier = 2
ranged_dice_modifier = 2
model_scene_path = "res://assets/models/characters/Heretic_Priest.glb"
is_leader = true
has_tough = true
abilities = Array[Resource]([ExtResource("4")])
attacks = Array[Resource]([ExtResource("2"), ExtResource("3_l2gnn")])
