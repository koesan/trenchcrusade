; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Iron Requiem"
config/description="Karanlık hendek-fantazi atmosferinde sıra tabanlı taktiksel çok oyunculu masa oyunu."
run/main_scene="res://scenes/ui/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.054902, 0.0431373, 0.027451, 1)

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameLogger="*res://scripts/logger.gd"
GameConfig="*res://scripts/game_config.gd"
NetworkManager="*res://scripts/networking/network_manager.gd"
GameState="*res://scripts/game_state/game_state.gd"
ScenarioManager="*res://scripts/scenario/scenario_manager.gd"
TerrainManager="*res://scripts/scenario/terrain_manager.gd"
ArmouryManager="*res://scripts/game_state/armoury_manager.gd"
CombatChoice="*res://scripts/combat/combat_choice.gd"
TurnManager="*res://scripts/turn_manager/turn_manager.gd"
GameEvents="*res://scripts/game_state/game_events.gd"
LocalizationManager="*res://scripts/ui/localization_manager.gd"
DiceManager="*res://scripts/dice/dice_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
LoadingManager="*res://scripts/ui/loading_manager.gd"
SaveManager="*res://scripts/utils/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/textures/ui/maus_icon.png"

[gui]

theme/custom="res://assets/themes/gothic_theme.tres"

